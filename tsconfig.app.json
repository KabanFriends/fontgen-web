{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "noImplicitOverride": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
        "types": [],
        "noEmit": true
    },
    "include": ["src/**/*.ts", "app/**/*.ts", "vite.config.ts"]
}
